<div class="container px-5 px-sm-0 mt-4">
  <div class="row">

    <!-- 左側：Homeと同じUser info・New book -->
    <div class="col-md-3">
      <h2>User info</h2>

      <%= image_tag @book.user.get_profile_image(100, 100) %>

      <table class="table">
        <tbody>
          <tr>
            <th>name</th>
            <td><%= @book.user.name %></td>
          </tr>
          <tr>
            <th>introduction</th>
            <td><%= @book.user.introduction %></td>
          </tr>
        </tbody>
      </table>

      <%= link_to edit_user_path(@book.user),
                 class: "btn btn-outline-secondary w-100 mb-3" do %>
        <i class="fa-solid fa-user-gear"></i>
      <% end %>

      <h2>New book</h2>

      <%= form_with model: Book.new do |f| %>
        <div class="mb-3">
          <%= f.label :title, "Title" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :body, "Opinion" %>
          <%= f.text_area :body, class: "form-control" %>
        </div>

        <%= f.submit "Create Book", class: "btn btn-success" %>
      <% end %>
    </div>

    <!-- 右側：Book detail -->
    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>

      <table class="table">
        <tbody>
          <tr>
            <td>
              <%= image_tag @book.user.get_profile_image(100, 100) %>
              <br>
              <%= link_to @book.user.name, user_path(@book.user) %>
            </td>

            <td>
              <%= link_to @book.title, book_path(@book) %>
            </td>

            <td><%= @book.body %></td>

            <% if @book.user == Current.session.user %>
              <td>
                <%= link_to "Edit", edit_book_path(@book),
                    class: "btn btn-success" %>
              </td>
              <td>
                <%= link_to "Destroy", book_path(@book),
                    data: { 
                      turbo_method: :delete,
                      turbo_confirm: "本当に消しますか？"
                    },
                    class: "btn btn-danger" %>
                  </td>
               <% end %>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </div>