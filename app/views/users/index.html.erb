<div class="container px-5 px-sm-0">
  <div class="row">
    <div class="col-md-3">
      <h2>User info</h2>

      <%= image_tag Current.session.user.get_profile_image(100, 100) %>

      <table class="table">
        <tbody>
          <tr>
            <th>name</th>
            <td><%= Current.session.user.name %></td>
          </tr>
          <tr>
            <th>introduction</th>
            <td><%= Current.session.user.introduction %></td>
          </tr>
        </tbody>
      </table>


      <div class="mb-3">
        <%= link_to edit_user_path(Current.session.user),
            class: "btn btn-outline-secondary w-100 profile-edit-btn",
            title: "プロフィール編集",
            aria: { label: "プロフィール編集" } do %>
          <i class="fa-solid fa-user-gear"></i>
        <% end %>
      </div>

      <h2>New book</h2>

      <%= form_with model: Book.new do |f| %>
        <div class="mb-3">
          <%= f.label :title, "Title" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :body, "Opinion" %>
          <%= f.text_area :body, class: "form-control" %>
        </div>

        <%= f.submit "Create Book", class: "btn btn-success" %>
      <% end %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Users</h2>

      <table class="table">
        <thead>
          <tr>
            <th>image</th>
            <th>name</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <%= image_tag user.get_profile_image(50, 50) %>
              </td>
              <td><%= user.name %></td>
              <td><%= link_to "Show", user_path(user) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>