<h1>Sign up</h1>
 <% if @user&.errors&.any? %>
          <div>
            <h2>
              <%= pluralize(@user.errors.count, "error") %>
              prohibited this obj from being saved:
            </h2>

            <ul>
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

<%= form_with model: @user do |f| %>


  <div class="mb-3">
    <%= f.label :name, "Name" %>
    <%= f.text_field :name, autofocus: true, class: "form-control", style: "max-width: 150px;" %>
  </div>

  <div class="mb-3">
    <%= f.label :email_address, "Email" %>
    <%= f.email_field :email_address, class: "form-control", style: "max-width: 150px;" %>
  </div>

  <div class="mb-3">
    <%= f.label :password do %>
    Password <span>(6 characters minimum)</span>
  <% end %>
    <%= f.password_field :password, class: "form-control", style: "max-width: 150px;" %>
  </div>

  <div class="mb-3">
    <%= f.label :password_confirmation, "Password confirmation" %>
    <%= f.password_field :password_confirmation, class: "form-control", style: "max-width: 150px;" %>
  </div>

  <div>
    <%= f.submit "Sign up", class: "btn btn-success" %>
  </div>

  <div class="mt-3">
    <%= link_to "Log in", new_session_path, class: "text-decoration-none" %>
  </div>

<% end %>


