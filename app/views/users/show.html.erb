<div class="container px-5 px-sm-0 mt-4">
  <div class="row">

    <!-- 左側：プロフィールとNew book -->
    <div class="col-md-3">
      <h2>User info</h2>

      <%= image_tag @user.get_profile_image(100, 100) %>

      <table class="table">
        <tbody>
          <tr>
            <th>name</th>
            <td><%= @user.name %></td>
          </tr>
          <tr>
            <th>introduction</th>
            <td><%= @user.introduction %></td>
          </tr>
        </tbody>
      </table>

     
      <%= link_to(
           @user == Current.session.user ? edit_user_path(@user) : edit_user_path(@user),
           class: "btn btn-outline-secondary w-100 mb-3"
         ) do %>
       <i class="fa-solid fa-user-gear"></i>
     <% end %>

      <!-- New bookを左側に配置 -->
      <h2>New book</h2>

      <%= form_with model: Book.new do |f| %>
        <div class="mb-3">
          <%= f.label :title, "Title" %>
          <%= f.text_field :title,
              class: "form-control",
              style: "max-width: 200px;" %>
        </div>

        <div class="mb-3">
          <%= f.label :body, "Opinion" %>
          <%= f.text_area :body,
              class: "form-control",
              style: "max-width: 200px; height: 80px;" %>
        </div>

        <%= f.submit "Create Book", class: "btn btn-success" %>
      <% end %>
    </div>

    <!-- 右側：Books一覧 -->
    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>

      <table class="table">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
            <th></th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @books.each do |book| %>
            <tr>
              <td>
                <%= link_to user_path(@user) do %>
                  <%= image_tag book.user.get_profile_image(50, 50) %>
                <% end %>
              </td>

              <td>
                <%= link_to book.title, book_path(book) %>
              </td>

              <td><%= book.body %></td>

              <% if book.user == Current.session.user %>
                <td>
                  <%= link_to "Edit", edit_book_path(book),
                      class: "btn btn-success" %>
                </td>
                <td>
                  <%= button_to "Destroy", book_path(book),
                      method: :delete,
                      class: "btn btn-danger",
                      form: { data: { turbo_confirm: "本当に削除しますか？" } } %>
                </td>
              <% else %>
                <td></td>
                <td></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>